# ==============================================================================
# Usage-Based Insurance Backend Environment Template
# ==============================================================================
# Copy this file to '.env' and specify your local configuration.
# Never commit the actual '.env' containing passwords to git.

# Server HTTP Port (Render automatically supplies PORT)
SERVER_PORT=8080
PORT=8080

# Active Spring Profile
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Credentials & Connection Details
DB_HOST=localhost
DB_PORT=3306
DB_NAME=usage_based_insurance
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here
DB_USE_SSL=false
# Alternatively, specify a full JDBC URL:
# SPRING_DATASOURCE_URL=jdbc:mysql://host:port/dbname?useSSL=true&serverTimezone=UTC

# Allowed CORS Origins (comma-separated for multiple origins, e.g. local and production Vercel)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Cookie & Session Security (Set COOKIE_SECURE=true and COOKIE_SAME_SITE=None for cross-site production)
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Insurer Production Provisioning (disable demo customer in production)
BOOTSTRAP_CUSTOMER_ENABLED=true
BOOTSTRAP_INSURER_EMAIL=insurer@trustdrive.internal
BOOTSTRAP_INSURER_PASSWORD=InsurerSecure2026!
