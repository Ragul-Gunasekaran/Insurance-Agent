# ==============================================================================
# Usage-Based Insurance Backend Environment Template
# ==============================================================================
# Copy this file to '.env' and specify your local configuration.
# Never commit the actual '.env' containing passwords to git.

# Server HTTP Port
SERVER_PORT=8080

# Active Spring Profile
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Credentials & Connection Details
DB_HOST=localhost
DB_PORT=3306
DB_NAME=usage_based_insurance
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Allowed CORS Origin for Local Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173
