# ==============================================================================
# Usage-Based Insurance (UBI) Platform - Root Environment Template
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - NEVER commit sensitive credentials (passwords, tokens, keys) to version control.
# - Copy this file to '.env' in your local environment and fill in your values.
# - Backend and Frontend environment variables are kept isolated for security:
#     * Backend env vars (DB_*, SERVER_*) are secret and only accessible on the server.
#     * Frontend env vars (VITE_*) are embedded in the browser client bundle.
#     * NEVER place database passwords or server secrets into VITE_* variables!
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Spring Boot)
# ------------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=usage_based_insurance
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Frontend CORS Origin (Local development origin allowed by Spring Boot)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------------------
# Frontend Configuration (React / Vite)
# ------------------------------------------------------------------------------
# Note: In Vite, only variables prefixed with VITE_ are exposed to client code.
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_TITLE=Usage-Based Insurance Platform
